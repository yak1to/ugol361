---
import Base from '../layouts/Base.astro';
import Preloader from '../components/sections/Preloader.astro';
import Hero from '../components/sections/Hero.astro';
import Door from '../components/sections/Door.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import Lookbook from '../components/sections/Lookbook.astro';
import Prices from '../components/sections/Prices.astro';
import Marquee from '../components/sections/Marquee.astro';
import Barbers from '../components/sections/Barbers.astro';
import Reviews from '../components/sections/Reviews.astro';
import FindUs from '../components/sections/FindUs.astro';
import FooterCta from '../components/sections/FooterCta.astro';
import DegreeCounter from '../components/motion/DegreeCounter.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import { site } from '../config/site';
import { barbershopJsonLd } from '../lib/jsonld';
---
<Base jsonLd={barbershopJsonLd(Astro.site!)}>
  <Preloader />
  <DegreeCounter value={0} class="deg-fixed" />
  <main id="main">
    <Hero />
    <Door />
    <Manifesto />
    <Lookbook />
    <Prices />
    <Marquee />
    <Barbers />
    <Reviews />
    <FindUs />
  </main>
  <FooterCta />
  <MobileBar />
</Base>

<script>
  // Мобильная панель записи: видна, когда ни кнопка в хиро, ни футер не в кадре
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const watch = [document.querySelector('.hero__cta'), document.querySelector('.fcta')].filter(Boolean) as Element[];
  if (bar && watch.length) {
    const seen = new Set<Element>();
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
      bar.classList.toggle('is-on', seen.size === 0);
    });
    watch.forEach((el) => io.observe(el));
  }

  // Карта: живой виджет Яндекса тяжёлый. На телефоне — только по нажатию (иначе лагает скролл),
  // на десктопе — сам, когда секция в кадре и скролл остановился.
  document.querySelectorAll<HTMLElement>('[data-map-src]').forEach((box) => {
    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      const f = document.createElement('iframe');
      f.src = box.dataset.mapSrc!; f.title = 'Угол 361 на Яндекс Картах'; f.allowFullscreen = true;
      box.append(f);
      box.querySelector('[data-map-open]')?.remove();
    };
    box.querySelector('[data-map-open]')?.addEventListener('click', load);
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let t = 0;
      const io = new IntersectionObserver(([e]) => {
        clearTimeout(t);
        if (e.isIntersecting) t = window.setTimeout(() => { load(); io.disconnect(); }, 400);
      }, { threshold: 0.4 });
      io.observe(box);
    }
  });
</script>
<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
