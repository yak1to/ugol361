---
import PriceRow from '../ui/PriceRow.astro';
import PromoSticker from '../ui/PromoSticker.astro';
import { site } from '../../config/site';
import { url } from '../../lib/url';
interface Props { full?: boolean }
const { full = false } = Astro.props;
const p = site.prices;
---
<section class="inside prices" id="prices" aria-labelledby="prices-title">
  <div class="prices__head">
    <h2 id="prices-title" class="display prices__title">Прайс</h2>
    <p class="caption prices__date">{p.date}. Оплата картой, СБП или по QR.</p>
  </div>
  <ul class="prices__list">
    {p.items.map((i) => <PriceRow {...i} />)}
  </ul>
  <PromoSticker {...p.promo} class="prices__promo" />
  {!full && <a class="prices__more link-under" href={url("prices/")}>Все цены и условия</a>}
</section>

<style>
  .prices { position: relative; padding: clamp(72px, 10vw, 160px) 0 clamp(120px, 16vw, 240px); }
  .prices__head { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding: 0 var(--gutter) 20px; }
  .prices__title { font-size: var(--fs-h2); }
  .prices__list { margin: 0; padding: 0; border-bottom: 2px solid var(--ink); }
  .prices :global(.prices__promo) { position: absolute; right: 22vw; bottom: clamp(30px, 5vw, 90px); --tilt: 4deg; }
  .prices__more { display: inline-block; margin: 28px var(--gutter) 0; font-size: var(--fs-lead); text-decoration: none; }
  @media (max-width: 1024px) {
    .prices { padding-bottom: 72px; }
    .prices :global(.prices__promo) { position: relative; right: auto; bottom: auto; margin: 36px var(--gutter) 0; display: block; }
  }
  @media (max-width: 760px) {
    .prices__head { flex-direction: column; align-items: start; }
  }
</style>
