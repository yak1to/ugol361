---
import Logo from '../ui/Logo.astro';
import { getImage } from 'astro:assets';
import ornamentSrc from '../../assets/photos/ornament-tile.jpg';
const ornament = await getImage({ src: ornamentSrc, format: 'webp', width: 1600, quality: 62 });
import { site } from '../../config/site';
---
<section class="facade hero" id="top" style={`--ornament:url(${ornament.src})`}>
  <div class="hero__ornament" aria-hidden="true"></div>

  <header class="hero__bar">
    <p class="hero__kicker caption">{site.kind}<br />{site.address.street}</p>
    <nav class="hero__nav caption" aria-label="Разделы">
      <a class="link-under" href="#prices">Цены</a>
      <a class="link-under" href="#works">Работы</a>
      <a class="link-under" href="#find">Как найти</a>
      <a class="link-under" href={site.phone.href}>{site.phone.display}</a>
    </nav>
  </header>

  <h1 class="hero__title">
    <span class="visually-hidden">{site.name} — {site.kind} у метро {site.address.metro}</span>
    <Logo class="hero__logo" />
  </h1>

  <div class="hero__foot">
    <p class="hero__line">{site.hero.line}</p>
    <div class="hero__cta">
      <a class="btn btn--big" href={site.booking.href} target="_blank" rel="noopener" data-magnetic>{site.booking.label}</a>
      <a class="hero__rating caption" href={site.rating.url} rel="noopener" target="_blank">
        <span class="numeral">{site.rating.value.toFixed(1)}</span> на Яндекс Картах, {site.rating.votes} оценки
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto;
    padding: 20px var(--gutter) clamp(24px, 4vw, 48px); overflow: hidden;
  }
  .hero__ornament {
    position: absolute; inset: -10% 0; z-index: -2;
    background: var(--ornament) 0 0 / 1100px auto repeat; opacity: .55;
  }
  .hero__bar { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
  .hero__kicker { opacity: .8; margin: 0; }
  .hero__nav { display: flex; gap: clamp(14px, 2.4vw, 32px); flex-wrap: wrap; justify-content: flex-end; }
  .hero__nav a { text-decoration: none; }

  .hero__title { margin: 0; align-self: center; }
  /* логотип почти во всю ширину, чуть вылезает за левое поле */
  .hero__title :global(.hero__logo) { width: min(100%, 1500px); margin-left: -.5vw; }

  .hero__foot { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 32px; }
  .hero__line { margin: 0; font-size: var(--fs-lead); line-height: 1.1; max-width: 17ch; }
  .hero__cta { display: grid; justify-items: end; gap: 12px; }
  .hero__rating { text-decoration: none; opacity: .85; }
  .hero__rating .numeral { font-size: 15px; }

  @media (max-width: 760px) {
    .hero__nav a:not(:last-child) { display: none; }
    .hero__title { align-self: end; padding-bottom: 8vh; }
    .hero__foot { grid-template-columns: 1fr; }
    .hero__cta { justify-items: start; }
  }
</style>
