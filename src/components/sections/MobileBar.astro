---
// Только телефон: панель «Записаться / позвонить» снизу. Появляется после хиро,
// прячется у футера (там своя большая кнопка). Внутри — счётчик градусов.
import DegreeCounter from '../motion/DegreeCounter.astro';
import { site } from '../../config/site';
---
<div class="mbar" data-mbar>
  <a class="btn mbar__book" href={site.booking.href} target="_blank" rel="noopener">{site.booking.label}</a>
  <a class="mbar__call" href={site.phone.href} aria-label={`Позвонить: ${site.phone.display}`}>
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
  </a>
  <DegreeCounter value={0} class="mbar__deg" />
</div>
<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    .mbar {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      display: flex; align-items: center; gap: 10px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: var(--ink); color: var(--paper);
      transform: translateY(110%); transition: transform 280ms var(--ease-out);
      box-shadow: 0 -1px 0 rgba(255,255,255,.08);
    }
    .mbar:global(.is-on) { transform: none; }
    .mbar__book { flex: 1; justify-content: center; font-size: 20px; padding: .62em 1em .55em; }
    .mbar__call {
      flex: none; width: 50px; height: 50px; display: grid; place-items: center;
      border: 2px solid var(--paper); color: var(--paper);
    }
    .mbar :global(.mbar__deg) { flex: none; min-width: 3.4em; justify-content: flex-end; font-size: 20px !important; }
  }
</style>
