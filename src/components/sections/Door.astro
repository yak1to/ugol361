---
import { Picture } from 'astro:assets';
import { photo } from '../../lib/photos';
import { site } from '../../config/site';
---
<section class="facade door" aria-labelledby="door-title">
  <div class="door__intro">
    <h2 id="door-title" class="display door__title">{site.door.title}</h2>
    <p class="door__text">{site.door.text}</p>
  </div>
  <figure class="door__photo">
    <Picture src={photo('11.jpg')} formats={['avif', 'webp']} widths={[360, 560, 860]} sizes="(max-width: 760px) 70vw, 30vw" alt="Вход: красная рамка двери, логотип на стекле, барберский столб и флаг под вывеской «Топ цветы»" />
  </figure>
</section>

<style>
  .door {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 6vw; align-items: end;
    padding: clamp(80px, 12vw, 180px) var(--gutter) clamp(48px, 6vw, 96px);
  }
  .door__title { font-size: var(--fs-h2); max-width: 9ch; }
  .door__text { max-width: 34ch; margin: 28px 0 0; }
  .door__photo { margin: 0; justify-self: end; width: min(100%, 420px); transform: rotate(2deg); border: 8px solid var(--paper); }
  .door__photo :global(img) { width: 100%; height: auto; }

  @media (max-width: 760px) {
    .door { grid-template-columns: 1fr; }
    .door__photo { justify-self: start; width: 72%; }
  }
</style>
