---
// Шрифты: только нужные наборы (кириллица, латиница, latin-ext ради ₽). Rubik Spray — только в стайлгайде
import '@fontsource/playfair-display/cyrillic-400-italic.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/playfair-display/latin-ext-400-italic.css';
import '@fontsource/playfair-display/cyrillic-700-italic.css';
import '@fontsource/playfair-display/latin-700-italic.css';
import '../styles/global.css';
import { site } from '../config/site';
import { url } from '../lib/url';
import oswald_cyrillic from '@fontsource-variable/oswald/files/oswald-cyrillic-wght-normal.woff2?url';
import oswald_latin from '@fontsource-variable/oswald/files/oswald-latin-wght-normal.woff2?url';
import oswald_latin_ext from '@fontsource-variable/oswald/files/oswald-latin-ext-wght-normal.woff2?url';
import onest_cyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onest_latin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import onest_latin_ext from '@fontsource-variable/onest/files/onest-latin-ext-wght-normal.woff2?url';

interface Props { title?: string; description?: string; jsonLd?: object; noindex?: boolean }
const {
  title = `${site.name} — ${site.kind} у метро ${site.address.metro}`,
  description = `${site.name}: ${site.kind} у м. ${site.address.metro}. Блонд, окрашивание, завивка, стрижки. ${site.rating.value.toFixed(1)} на Яндекс Картах.`,
  jsonLd, noindex = false,
} = Astro.props;
const fontFaces = `@font-face{font-family:'Oswald Variable';font-style:normal;font-display:swap;font-weight:200 700;src:url(${oswald_cyrillic}) format('woff2-variations');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}@font-face{font-family:'Oswald Variable';font-style:normal;font-display:swap;font-weight:200 700;src:url(${oswald_latin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Oswald Variable';font-style:normal;font-display:swap;font-weight:200 700;src:url(${oswald_latin_ext}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}@font-face{font-family:'Onest Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onest_cyrillic}) format('woff2-variations');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}@font-face{font-family:'Onest Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onest_latin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:'Onest Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onest_latin_ext}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.png'), Astro.site);

const kebab = (s: string) => s.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase());
const tokens = [
  ...Object.entries(site.theme.colors).map(([k, v]) => `--${kebab(k)}:${v}`),
  ...Object.entries(site.theme.fonts).map(([k, v]) => `--font-${k}:${v}`),
].join(';');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content={site.theme.colors.wine} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <style set:html={fontFaces + `:root{${tokens}}`}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        // прелоадер: «361» крутится в букве О (и на десктопе, и на телефоне)
        document.documentElement.classList.add('intro');
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">К содержимому</a>
    <slot />
  </body>
</html>
